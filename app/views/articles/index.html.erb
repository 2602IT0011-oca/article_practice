<div class="page-container">
  <h1 class="page-title">投稿一覧</h1>

  <% if flash[:notice] %>
    <p class="flash-message flash-success">
      <%= flash[:notice] %>
    </p>
  <% end %>

  <% if flash[:alert] %>
    <p class="flash-message flash-error">
      <%= flash[:alert] %>
    </p>
  <% end %>

  <div class="page-actions">
    <%= link_to "新規投稿", new_article_path, class: "button button-primary" %>
  </div>

  <% if @articles.any? %>
    <table class="article-table">
      <thead>
        <tr>
          <th>ID</th>
          <th>タイトル</th>
          <th>投稿内容</th>
        </tr>
      </thead>
      <tbody>
        <% @articles.each do |article| %>
          <tr>
            <td><%= article.id %></td>
            <td>
              <%= link_to article.title, article_path(article) %>
            </td>
            <td><%= truncate(article.content, length: 50) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p>投稿はまだありません。</p>
  <% end %>
</div>